[
 {
  "i": 0,
  "text": "Two a.m.",
  "t0": 0.3,
  "t1": 1.1,
  "f0": 9,
  "f1": 33
 },
 {
  "i": 1,
  "text": "Frozen pizza.",
  "t0": 1.35,
  "t1": 2.332,
  "f0": 40,
  "f1": 70
 },
 {
  "i": 2,
  "text": "No oven.",
  "t0": 2.582,
  "t1": 3.247,
  "f0": 77,
  "f1": 97
 },
 {
  "i": 3,
  "text": "So... you have to invent one.",
  "t0": 3.567,
  "t1": 4.959,
  "f0": 107,
  "f1": 149
 },
 {
  "i": 4,
  "text": "First idea: fire!",
  "t0": 5.539,
  "t1": 6.63,
  "f0": 166,
  "f1": 199
 },
 {
  "i": 5,
  "text": "Okay. The kitchen is on fire.",
  "t0": 7.28,
  "t1": 9.031,
  "f0": 218,
  "f1": 271
 },
 {
  "i": 6,
  "text": "Fine. You get smarter.",
  "t0": 9.681,
  "t1": 10.825,
  "f0": 290,
  "f1": 325
 },
 {
  "i": 7,
  "text": "What if you heat the food... without fire?",
  "t0": 11.185,
  "t1": 13.13,
  "f0": 336,
  "f1": 394
 },
 {
  "i": 8,
  "text": "With invisible waves.",
  "t0": 13.42,
  "t1": 14.651,
  "f0": 403,
  "f1": 440
 },
 {
  "i": 9,
  "text": "You snap together a magnet, a copper block... and it hums.",
  "t0": 15.011,
  "t1": 18.246,
  "f0": 450,
  "f1": 547
 },
 {
  "i": 10,
  "text": "But wait. The waves go everywhere.",
  "t0": 18.746,
  "t1": 20.496,
  "f0": 562,
  "f1": 615
 },
 {
  "i": 11,
  "text": "The cat. The radio. The whole street.",
  "t0": 20.786,
  "t1": 22.429,
  "f0": 624,
  "f1": 673
 },
 {
  "i": 12,
  "text": "So you trap them. In a metal box.",
  "t0": 22.929,
  "t1": 24.818,
  "f0": 688,
  "f1": 745
 },
 {
  "i": 13,
  "text": "Now they just bounce around inside.",
  "t0": 25.108,
  "t1": 26.792,
  "f0": 753,
  "f1": 804
 },
 {
  "i": 14,
  "text": "But now you can't see your pizza.",
  "t0": 27.292,
  "t1": 28.845,
  "f0": 819,
  "f1": 865
 },
 {
  "i": 15,
  "text": "Add a window, and the waves escape...",
  "t0": 29.095,
  "t1": 30.865,
  "f0": 873,
  "f1": 926
 },
 {
  "i": 16,
  "text": "unless you cover it with a net, with holes way smaller than the waves.",
  "t0": 31.115,
  "t1": 34.798,
  "f0": 933,
  "f1": 1044
 },
 {
  "i": 17,
  "text": "They're too fat to squeeze through.",
  "t0": 35.048,
  "t1": 36.522,
  "f0": 1051,
  "f1": 1096
 },
 {
  "i": 18,
  "text": "Now look inside the cheese.",
  "t0": 37.022,
  "t1": 38.4,
  "f0": 1111,
  "f1": 1152
 },
 {
  "i": 19,
  "text": "The waves grab tiny bits of water, and flip them back and forth.",
  "t0": 38.69,
  "t1": 42.361,
  "f0": 1161,
  "f1": 1271
 },
 {
  "i": 20,
  "text": "Billions of times a second.",
  "t0": 42.611,
  "t1": 43.921,
  "f0": 1278,
  "f1": 1318
 },
 {
  "i": 21,
  "text": "All that jiggling? That's heat.",
  "t0": 44.241,
  "t1": 45.802,
  "f0": 1327,
  "f1": 1374
 },
 {
  "i": 22,
  "text": "One problem.",
  "t0": 46.382,
  "t1": 47.216,
  "f0": 1391,
  "f1": 1416
 },
 {
  "i": 23,
  "text": "The edges are lava...",
  "t0": 47.506,
  "t1": 48.692,
  "f0": 1425,
  "f1": 1461
 },
 {
  "i": 24,
  "text": "and the middle is still frozen.",
  "t0": 48.942,
  "t1": 50.419,
  "f0": 1468,
  "f1": 1513
 },
 {
  "i": 25,
  "text": "Some spots get all the waves. Some get nothing.",
  "t0": 50.779,
  "t1": 53.335,
  "f0": 1523,
  "f1": 1600
 },
 {
  "i": 26,
  "text": "Easy fix. Make the pizza spin.",
  "t0": 53.835,
  "t1": 55.626,
  "f0": 1615,
  "f1": 1669
 },
 {
  "i": 27,
  "text": "Now every bite takes a turn in the hot spots.",
  "t0": 55.916,
  "t1": 58.381,
  "f0": 1677,
  "f1": 1751
 },
 {
  "i": 28,
  "text": "Ding!",
  "t0": 58.811,
  "t1": 59.233,
  "f0": 1764,
  "f1": 1777
 },
 {
  "i": 29,
  "text": "Congrats. You just invented the microwave.",
  "t0": 59.663,
  "t1": 62.035,
  "f0": 1790,
  "f1": 1861
 },
 {
  "i": 30,
  "text": "And those waves? Almost the same ones your Wi-Fi uses.",
  "t0": 62.465,
  "t1": 65.564,
  "f0": 1874,
  "f1": 1967
 },
 {
  "i": 31,
  "text": "That's why your video lags... when someone makes popcorn.",
  "t0": 65.814,
  "t1": 68.867,
  "f0": 1974,
  "f1": 2066
 }
]