"sentences": [
{
"s": 0,
"text": "Meet Dave.",
"t": 0.35,
"end": 1.106
},
{
"s": 1,
"text": "Dave wants a screen that feels his finger...",
"t": 1.356,
"end": 3.363
},
{
"s": 2,
"text": "and pokes back.",
"t": 3.563,
"end": 4.418
},
{
"s": 3,
"text": "Problem: it's nineteen sixty-five.",
"t": 4.918,
"end": 6.728
},
{
"s": 4,
"text": "Screens feel nothing.",
"t": 6.928,
"end": 8.079
},
{
"s": 5,
"text": "So Dave copies a British radar engineer.",
"t": 8.529,
"end": 10.769
},
{
"s": 6,
"text": "Cover the glass in a thin layer of electricity.",
"t": 11.069,
"end": 13.438
},
{
"s": 7,
"text": "Your finger is basically a bag of salty water...",
"t": 13.738,
"end": 16.372
},
{
"s": 8,
"text": "so it steals a tiny bit of charge.",
"t": 16.522,
"end": 18.374
},
{
"s": 9,
"text": "The screen notices the theft. That's your touch.",
"t": 18.674,
"end": 21.03
},
{
"s": 10,
"text": "But Dave thinks electricity is scary.",
"t": 21.53,
"end": 23.295
},
{
"s": 11,
"text": "So: two plastic sheets, with a tiny gap.",
"t": 23.745,
"end": 25.841
},
{
"s": 12,
"text": "Press, they touch, and the circuit closes.",
"t": 26.091,
"end": 27.95
},
{
"s": 13,
"text": "Dave presses with a hammer.",
"t": 28.3,
"end": 29.562
},
{
"s": 14,
"text": "Not that hard, Dave.",
"t": 30.162,
"end": 31.249
},
{
"s": 15,
"text": "Plan C: a grid of invisible light beams.",
"t": 31.749,
"end": 34.179
},
{
"s": 16,
"text": "Block a beam, and the screen knows where.",
"t": 34.429,
"end": 36.31
},
{
"s": 17,
"text": "Then a fly lands on it.",
"t": 36.66,
"end": 37.831
},
{
"s": 18,
"text": "Plan C is fired.",
"t": 38.531,
"end": 39.602
},
{
"s": 19,
"text": "Pressure screens win, for now. Phones get a little pen.",
"t": 40.102,
"end": 42.989
},
{
"s": 20,
"text": "Dave loses it in four minutes.",
"t": 43.289,
"end": 44.881
},
{
"s": 21,
"text": "Then, two thousand seven. Back to stealing electricity...",
"t": 45.431,
"end": 48.465
},
{
"s": 22,
"text": "but with a grid of wires too thin to see.",
"t": 48.615,
"end": 50.585
},
{
"s": 23,
"text": "Now it feels ten fingers at once.",
"t": 50.885,
"end": 52.592
},
{
"s": 24,
"text": "Then winter comes.",
"t": 53.042,
"end": 54.067
},
{
"s": 25,
"text": "Gloves don't conduct, Dave. Nothing to steal.",
"t": 54.617,
"end": 57.014
},
{
"s": 26,
"text": "New problem: Dave's face grease.",
"t": 57.514,
"end": 59.292
},
{
"s": 27,
"text": "So the glass gets an oil-repelling coat. Grease just slides off.",
"t": 59.692,
"end": 63.175
},
{
"s": 28,
"text": "Today, the touch sensor is built right into the screen.",
"t": 63.625,
"end": 66.304
},
{
"s": 29,
"text": "And with OLED, every pixel makes its own light...",
"t": 66.554,
"end": 68.916
},
{
"s": 30,
"text": "so thin, the screen can fold.",
"t": 69.066,
"end": 70.625
},
{
"s": 31,
"text": "The other way, Dave.",
"t": 71.225,
"end": 72.304
},
{
"s": 32,
"text": "Finally: a screen that pokes back.",
"t": 72.904,
"end": 74.682
}
],
