"sentences": [
{
"s": 0,
"text": "Your headphones kill noise...",
"t": 0.35,
"end": 1.7
},
{
"s": 1,
"text": "by making more noise.",
"t": 1.82,
"end": 2.934
},
{
"s": 2,
"text": "Rush hour. Screaming baby. Screeching brakes.",
"t": 3.334,
"end": 5.706
},
{
"s": 3,
"text": "Dave taps one button...",
"t": 5.956,
"end": 7.214
},
{
"s": 4,
"text": "and the whole train disappears.",
"t": 7.364,
"end": 8.868
},
{
"s": 5,
"text": "So what just happened in there?",
"t": 9.318,
"end": 10.625
},
{
"s": 6,
"text": "First, a tiny microphone on the outside listens to the train.",
"t": 10.925,
"end": 14.16
},
{
"s": 7,
"text": "Sound is just air, wiggling in waves.",
"t": 14.41,
"end": 16.312
},
{
"s": 8,
"text": "A chip copies that wave... and flips it upside down.",
"t": 16.562,
"end": 19.527
},
{
"s": 9,
"text": "The speaker plays the flipped wave into your ear.",
"t": 19.777,
"end": 21.964
},
{
"s": 10,
"text": "Every hill meets a valley... and they cancel out.",
"t": 22.214,
"end": 24.64
},
{
"s": 11,
"text": "Noise, plus anti-noise, equals silence.",
"t": 24.89,
"end": 27.165
},
{
"s": 12,
"text": "A second mic inside checks what's left, and fixes it, thousands of times a second.",
"t": 27.565,
"end": 32.176
},
{
"s": 13,
"text": "It's best at steady hums, like engines.",
"t": 32.476,
"end": 34.461
},
{
"s": 14,
"text": "High, sharp sounds change too fast to copy...",
"t": 34.611,
"end": 36.933
},
{
"s": 15,
"text": "so the soft cushions block those.",
"t": 37.053,
"end": 38.779
},
{
"s": 16,
"text": "Now Dave hears nothing.",
"t": 39.179,
"end": 40.357
},
{
"s": 17,
"text": "Not even his stop.",
"t": 40.657,
"end": 41.7
}
],
